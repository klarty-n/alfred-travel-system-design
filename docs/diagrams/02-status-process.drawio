          <mxGeometry x="1933" y="761" width="54" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cell-window-label" value="Есть безопасное окно?" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;" vertex="1" parent="cell-alfred" bpmn_type="decoration">
          <mxGeometry x="1999" y="761" width="290" height="54" as="geometry" />
        </mxCell>
        <mxCell id="cell-wait-activity" value="Закрыть неактуальные последствия&#10;Сохранить status_update и доставку&#10;Impact waiting_activity + SearchRun&#10;Задача поиска активности (стр. 3)" style="rounded=1;arcSize=12;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=9;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#53677b;" vertex="1" parent="cell-alfred" bpmn_type="task">
