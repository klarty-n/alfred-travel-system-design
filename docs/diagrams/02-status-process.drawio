        <mxCell id="cell-filter-note" value="Неизвестные обязательные данные не считаются разрешением. Учитываются подтверждённый допбагаж и полная цена группы&#10;Активность не заменяет перелёт. Изменения броней видны до выбора" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fontSize=14;fontColor=#53677b;" vertex="1" parent="cell-alfred" bpmn_type="decoration">
          <mxGeometry x="65" y="500" width="1250" height="65" as="geometry" />
        </mxCell>
        <mxCell id="cell-generation" value="Offer, SearchRun с cursor/полнотой и переход задачи в ready/done фиксируются одной транзакцией. Сетевых запросов под блокировками нет&#10;Следующую страницу выполняет та же возобновляемая задача. Истечение всей выдачи создаёт новый SearchRun; поздняя страница не меняет текущий запуск&#10;Потеря lease / сбой БД не продвигают cursor. Допустимые варианты проверяются по накопленной актуальной выдаче, включая прежние страницы" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fontSize=14;fontColor=#53677b;" vertex="1" parent="1" bpmn_type="decoration">
          <mxGeometry x="25" y="1790" width="2700" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
