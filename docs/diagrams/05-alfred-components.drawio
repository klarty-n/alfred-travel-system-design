          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cell-app-note" value="Все модули используют одну БД через репозитории; API читает inbox и варианты после проверки доступа&#10;Worker выполняет задачи модулей; результаты опроса проходят тот же приём и проверку статуса" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;spacing=6;fontFamily=Arial;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="365" y="1480" width="1400" height="45" as="geometry" />
        </mxCell>
        <mxCell id="cell-db-note" value="Результат и следующая задача записываются одной транзакцией | Сетевые вызовы выполняются без блокировок БД&#10;Уведомления используют транзакцию вызывающего модуля: последствия / версия плана + inbox + outbox" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;spacing=6;fontFamily=Arial;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="365" y="1525" width="1400" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cell-legend" value="Чёрная стрелка: вызов интерфейса | Синяя «task»: логическая передача работы через OutboxTask, а не прямой вызов обработчика&#10;Очередь физически хранится в PostgreSQL; worker забирает задачи по lease | Исходные события поступают через служебный вход&#10;Все изображённые модули входят в одно приложение; порты TravelTech не означают отдельный сервер на каждый интерфейс" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;spacing=6;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="1620" width="2090" height="105" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>